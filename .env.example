# LLM API Keys for Smart Content Cleaning
# Copy this file to .env and add your API keys

# Anthropic API Key (for Claude models)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (for GPT models)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Note: You only need to set the API key for the provider you want to use
# - Use ANTHROPIC_API_KEY for Claude models (recommended: claude-3-5-haiku-20241022)
# - Use OPENAI_API_KEY for GPT models (recommended: gpt-4o-mini)
